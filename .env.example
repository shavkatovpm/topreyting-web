# Nusxa oling: cp .env.example .env  va qiymatlarni to'ldiring. .env git'ga tushmaydi.

# Lokal: SQLite. Droplet'da Postgres ulanish manzili bo'ladi.
DATABASE_URL="file:./prisma/dev.db"

# Admin sessiyasi imzosi (kamida 32 belgi):  openssl rand -hex 32
SESSION_SECRET=""

# Faqat `npm run db:seed` uchun: birinchi Super Admin
SEED_ADMIN_EMAIL="admin@topreyting.local"
SEED_ADMIN_PASSWORD=""

# Telegram (lokalda ixtiyoriy: bo'lmasa arizalar faqat admin paneldagi "Arizalar" bo'limida ko'rinadi)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_WEBHOOK_SECRET=""

# Telegram tugmasidagi "Panelda ochish" havolasi uchun (https bo'lishi shart)
NEXT_PUBLIC_SITE_URL=""

# Chek fayllari papkasi (bo'sh bo'lsa ./storage). Serverda doimiy papka bo'lsin.
STORAGE_DIR=""
